# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# faucet + program keypairs (secrets) -- NEVER commit these
deploy/*.json
.env.local
# src/lib/venue.json (and the retired market.json) are intentionally tracked as deploy-safe files:
# they hold the deployed program IDs, mints, vaults, a PUBLIC rpcUrl, and the demo identity keypairs
# (by-design public, the frontend signs with them in the browser, devnet only).
# INVARIANT: never put a private RPC key in these files. A keyed endpoint belongs in RPC / RPC_URL
# in .env.local or the host env — never in NEXT_PUBLIC_*, which is bundled into the client JS and
# readable by every visitor.

# the example carries no secrets and documents setup for anyone cloning the repo
!.env.local.example
